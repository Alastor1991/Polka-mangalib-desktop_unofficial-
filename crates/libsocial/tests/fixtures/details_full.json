8\u0442\u044c \u043d\u0430 \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0434\u0435\u0432\u0443\u0448\u043a\u043e\u0439 \u0438 \u0443\u043b\u044b\u0431\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c. \u041d\u043e \u0432\u0441\u0451 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c \u0441\u043e \u0441\u043c\u0435\u0440\u0442\u044c\u044e \u043e\u0442\u0446\u0430 \u2014 \u0442\u0435\u043f\u0435\u0440\u044c, \u041f\u043e\u0442\u0438\u0442\u0430, \u043f\u043e\u0440\u0430 \u0443\u0431\u0438\u0432\u0430\u0442\u044c!\u00bb \u2014 \u0441 \u0442\u0430\u043a\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0414\u044d\u043d\u0434\u0437\u0438, \u0432\u043c\u0435\u0441\u0442\u0435 \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u043f\u0441\u043e\u043c-\u0431\u0435\u043d\u0437\u043e\u043f\u0438\u043b\u043e\u0439, \u041f\u043e\u0442\u0438\u0442\u043e\u0439, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435, \u0432\u0435\u0434\u044c \u043e\u043d\u0438 \u2014 \u043e\u0445\u043e\u0442\u043d\u0438\u043a\u0438 \u043d\u0430 \u0434\u0435\u043c\u043e\u043d\u043e\u0432. \u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u043e\u043d\u0438 \u0443\u0431\u0438\u0432\u0430\u044e\u0442 \u0440\u0430\u0434\u0438 \u0434\u0435\u043d\u0435\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0414\u044d\u043d\u0434\u0437\u0438 \u0434\u043e\u043b\u0436\u0435\u043d \u043e\u0442\u0434\u0430\u0442\u044c \u043e\u0434\u043d\u043e\u043c\u0443 \u044f\u043a\u0443\u0434\u0437\u0435, \u0438\u043d\u0430\u0447\u0435 \u0434\u043e\u043b\u0433 \u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e \u043e\u0442\u0446\u0430 \u043f\u0440\u0438\u0434\u0451\u0442\u0441\u044f \u043e\u0442\u0434\u0430\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u